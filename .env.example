# =====================================================================
# DDCAP // ALTAY 2026 // CONFIGURATION ENVIRONMENT
# =====================================================================

# 1. AI API Base URL (OpenRouter, ProxyAPI, OpenAI, or local)
AI_BASE_URL=https://openrouter.ai/api/v1

# 2. AI API Key (Bearer Token)
AI_API_KEY=your_api_key_here

# 3. Model Name (e.g. google/gemini-2.5-flash, openai/gpt-4o-mini, deepseek/deepseek-chat)
AI_MODEL=google/gemini-2.5-flash

# 4. AI Agent Role (determines system prompt)
#    Options: blue_team | soc_analyst | red_team
#    blue_team    = Blue Team DevSecOps (Defense) - patching, SLA-safe fixes
#    soc_analyst  = SOC Analyst (Monitoring) - threat detection, IoC, MITRE ATT&CK
#    red_team     = Red Team Pentester (Exploits) - exploit creation, attack scripts
AI_AGENT_ROLE=blue_team

# Legacy fallback support
GEMINI_API_KEY=
GEMINI_MODEL=
